# ──────────────────────────────────────────────
# PTU Benchmark - Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# ── Two ways to use this tool ──────────────────
#
#  1. Project mode (recommended for POCs):
#     cp -r projects/template projects/my-customer
#     # Edit projects/my-customer/project.yaml
#     python -m ptu_benchmark --project projects/my-customer
#
#  2. Flat mode (legacy, uses this .env):
#     python -m ptu_benchmark
# ──────────────────────────────────────────────

# Model Studio API Key (obtain from Alibaba Cloud console)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx

# API base URL (international endpoint)
BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
