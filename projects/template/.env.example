# ──────────────────────────────────────────────
# PTU Benchmark — Project Environment
# ──────────────────────────────────────────────
# Copy this file to .env inside this project folder
# and fill in your API credentials.
#
#   cp .env.example .env
#
# Keep secrets here, not in project.yaml.

# Model Studio API Key (obtain from Alibaba Cloud console)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx

# API base URL (deployment-specific endpoint)
BASE_URL=https://your-deployment.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
